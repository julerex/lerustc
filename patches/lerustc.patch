@@ -41,5 +41,36 @@
 use tikv_jemalloc_sys as _;
 
 fn main() -> ExitCode {
+    #[cfg(feature = "embedded_wild")]
+    if std::env::var_os("LERUSTC_AS_LINKER").is_some() {
+        return run_wild();
+    }
+
     rustc_driver::main()
 }
+
+#[cfg(feature = "embedded_wild")]
+fn run_wild() -> ExitCode {
+    if let Err(error) = run_wild_inner() {
+        libwild::error::report_error_and_exit(&error);
+    }
+    ExitCode::SUCCESS
+}
+
+#[cfg(feature = "embedded_wild")]
+fn run_wild_inner() -> libwild::error::Result<()> {
+    libwild::init_timing()?;
+
+    let mut args = libwild::Args::new(|| std::env::args())?;
+    args.parse(|| std::env::args())?;
+
+    if libwild::should_fork(&args) {
+        // Safety: We haven't spawned any threads yet.
+        unsafe { libwild::run_in_subprocess(args) };
+    } else {
+        libwild::setup_tracing(&args)?;
+        libwild::run(args)?;
+    }
+
+    Ok(())
+}
